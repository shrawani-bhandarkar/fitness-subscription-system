# Required: MongoDB application database URI. Use a replica set for transactions.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Required: values from your Clerk application.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_publishable_key
CLERK_SECRET_KEY=sk_test_replace_with_your_secret_key

# Required to enable admin access: exact Clerk user ID of the administrator.
ADMIN_CLERK_USER_ID=user_replace_with_admin_clerk_id

# Required for the scheduled subscription expiry job in deployment.
# Generate a unique private value; never commit the real value.
CRON_SECRET=replace_with_a_long_random_secret

# Optional: set this to a Clerk webhook endpoint signing secret to enable
# verified user.created, user.updated, and user.deleted synchronization.
CLERK_WEBHOOK_SECRET=

# Optional: URI for the isolated fitness_subscription_dev database.
# The development seed helper rejects any database other than this one.
MONGODB_DEV_URI=mongodb+srv://<username>:<password>@<cluster-host>/fitness_subscription_dev?retryWrites=true&w=majority

# Optional: receipt display values (defaults: Fitness Club and no contact text).
RECEIPT_BUSINESS_NAME=Fitness Club
RECEIPT_BUSINESS_CONTACT=

# Optional, temporary development opt-in. Set to "true" only when running
# npm run seed:dev, then unset it. Never set this in production.
FSS_ALLOW_DEV_SEED=
